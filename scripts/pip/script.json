{
  "id": "pip",
  "name": "어떤 영상이든 PiP",
  "version": "1.0.0",
  "description": "영상을 PiP로 띄우기",
  "author": "TB's Browser",
  "icon": "icon.svg",
  "matches": [
    "https://*",
    "http://*"
  ],
  "run_at": "document_end",
  "js": [
    "main.js"
  ],
  "css": [],
  "resource_overrides": [],
  "permissions": [],
  "shortcuts": [
    {
      "id": "pip",
      "name": "PiP 켜고 끄기",
      "keys": "Alt+P"
    }
  ],
  "actions": [
    {
      "id": "pip",
      "name": "PiP"
    }
  ],
  "settings": [
    {
      "key": "hoverButton",
      "type": "toggle",
      "label": "영상 위에 PiP 버튼 보이기",
      "default": true
    }
  ],
  "enabled": false,
  "pinned": false
}
